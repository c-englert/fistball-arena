rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in Google user is a valid participant for now.
    // Per-event membership + roles (official / viewer) come in a later phase.
    function signedIn() {
      return request.auth != null;
    }

    // Games (schedule) — everyone signed in can read; seeding writes allowed
    // while there is no admin console yet. Tighten to admin-only later.
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Reports (súmulas) — signed-in users read all (for the live list) and
    // write. Lock discipline is enforced in the app via a transaction; server
    // rules keep it to authenticated users.
    match /reports/{gameId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Results — public scoreboard projection read by the Fistball Live
    // spectator app (no login). Only signed-in scorers write it (via the app).
    match /results/{gameId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Meta — shared admin config (e.g. the schedule-generator setup).
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
