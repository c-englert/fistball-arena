rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEV / emulator only — open access so we can validate realtime + locking
    // with a lightweight local identity. In production this is locked down:
    // only allow-listed Google accounts read; only the lock holder or an admin
    // writes a given report; only an admin clears another user's lock.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
